# Variáveis usadas pelo docker-compose.yml (Compose lê um ".env" na raiz
# automaticamente). Copie para ".env" e preencha com valores reais fortes.
# NUNCA suba o arquivo ".env" real para o repositório — ele já está no
# .gitignore.
#
# Gere valores fortes com:
#   openssl rand -base64 24   (senhas)
#   openssl rand -hex 32      (JWT_SECRET)

DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
