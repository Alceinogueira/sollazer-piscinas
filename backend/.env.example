# Renomeie este arquivo para ".env" e preencha com valores reais.
# NUNCA suba o arquivo ".env" real para o repositório (adicione ao .gitignore).

PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=sollazer_piscinas
DB_PORT=3306

# Segredo usado para assinar os tokens JWT do painel admin.
# Gere um valor longo e aleatório, ex: openssl rand -base64 48
JWT_SECRET=troque_este_segredo_por_uma_string_longa_e_aleatoria
JWT_EXPIRES_IN=8h
